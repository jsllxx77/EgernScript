#!name=小红书去广告
#!desc=净化信息流/搜索/开屏/详情页推广，移除图片与视频水印，解除评论图片下载限制；兼容 rnote.com。脚本已自托管。
#!author=fmz200[https://github.com/fmz200], RuCu6[https://github.com/RuCu6], 奶思；合并维护 jsllxx77
#!category=jsllxx77
#!tag=去广告
#!openUrl=https://apps.apple.com/app/id741292507
#!homepage=https://github.com/jsllxx77/EgernScript
#!date=2026-11-14
#!requirement=CORE_VERSION>=20
#!arguments=QUIC策略:REJECT
#!arguments-desc=QUIC策略：REJECT（默认，阻断 QUIC 使改写生效）或 DIRECT（放行 QUIC）

[Rule]
DOMAIN,ads-img-qc.xhscdn.com,REJECT
DOMAIN,ads-video-al.xhscdn.com,REJECT
DOMAIN,ads-video-qc.xhscdn.com,REJECT
DOMAIN,t-ads.xiaohongshu.com,REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,xiaohongshu.com)),{{{QUIC策略}}}

[Body Rewrite]
# --- 搜索页：内建 JQ 改写，无需外部脚本 ---
http-response-jq ^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/banner_list 'if (getpath([]) | has("data")) then (setpath(["data"]; {})) else . end'
http-response-jq ^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/hot_list 'if (getpath(["data"]) | has("items")) then (setpath(["data","items"]; [])) else . end'
http-response-jq ^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/hint 'if (getpath(["data"]) | has("hint_words")) then (setpath(["data","hint_words"]; [])) else . end'
http-response-jq ^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/trending 'if (getpath(["data"]) | has("queries")) then (setpath(["data","queries"]; [])) else . end'
http-response-jq ^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/trending 'if (getpath(["data"]) | has("hint_word")) then (setpath(["data","hint_word"]; {})) else . end'

[Map Local]
^https:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/www\.(xiaohongshu|rnote)\.com\/api\/marketing\/box\/trigger\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/guide\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/detailfeed\/preload\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/guide\/user_banner data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/www\.(xiaohongshu|rnote)\.com\/api\/sns\/(v\d+\/ads\/resource|v\d+\/hey\/\w+\/hey_gallery) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/ci\.(xiaohongshu|rnote)\.com\/system_config\/watermark data-type=tiny-gif status-code=200

[Script]
小红书搜索页 = type=http-response, pattern=^https?:\/\/(so|edith)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/notes\?, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/xiaohongshu.js, requires-body=true, timeout=60
小红书开屏广告 = type=http-response, pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/system_service\/config\?, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/xiaohongshu.js, requires-body=true, timeout=60
小红书开屏广告 = type=http-response, pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/system_service\/splash_config, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/xiaohongshu.js, requires-body=true, timeout=60
小红书详情页 = type=http-response, pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/widgets, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/xiaohongshu.js, requires-body=true, timeout=60
小红书图片视频水印 = type=http-response, pattern=^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/(imagefeed|live_photo\/save), script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/xiaohongshu.js, requires-body=true, timeout=60
小红书图片视频水印 = type=http-response, pattern=^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/(followfeed|homefeed)\?, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/xiaohongshu.js, requires-body=true, timeout=60
小红书图片视频水印 = type=http-response, pattern=^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/(v2\/note\/feed|v3\/note\/videofeed)\?, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/xiaohongshu.js, requires-body=true, timeout=60
小红书图片视频水印 = type=http-response, pattern=^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/(v4\/note\/videofeed|v10\/note\/video\/save)\?, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/xiaohongshu.js, requires-body=true, timeout=60
小红书评论区去水印存储 = type=http-response, pattern=^https:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/(v5\/note\/comment\/list|v3\/note\/comment\/sub_comments)\?, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/xiaohongshu.js, requires-body=true, timeout=60
小红书评论区去水印下载 = type=http-response, pattern=^https:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v1\/interaction\/comment\/video\/download\?, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/xiaohongshu.js, requires-body=true, timeout=60
小红书界面配置 = type=http-response, pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v1\/system\/service\/ui\/config\?, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/redpaper_remove_ads.js, requires-body=true, timeout=60
小红书关注页推荐 = type=http-response, pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v2\/user\/followings\/followfeed, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/redpaper_remove_ads.js, requires-body=true, timeout=60
小红书详情页推荐 = type=http-response, pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\?, script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/main/scripts/redpaper_remove_ads.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% edith.xiaohongshu.com, www.xiaohongshu.com, ci.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, edith.rnote.com, www.rnote.com, ci.rnote.com, so.rnote.com, rec.rnote.com
