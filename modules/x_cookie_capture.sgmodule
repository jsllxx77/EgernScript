#!name=X Cookie 捕获
#!desc=MITM 捕获 X 网页版的 auth_token + ct0，凑齐后自动推送服务器更新 parse_hub_bot。X 官方 App 不使用网页 Cookie（走 OAuth 且证书固定），请用浏览器打开 x.com
#!author=Shawn & Ali
#!homepage=https://github.com/jsllxx77/EgernScript
#!tag=X

[Script]
# 仅读取请求头 Cookie，不读取/改写 body；推送 key 通过 argument 传入（留空则只通知复制）
http-request ^https:\\/\\/([A-Za-z0-9-]+\\.)?(x\\.com|twitter\\.com)\\/.*$ script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/refs/heads/main/scripts/x_cookie_capture.js?v=20261021, requires-body=false, timeout=15, tag=X Cookie 捕获, argument=

[MITM]
hostname = x.com, *.x.com, twitter.com, api.twitter.com
