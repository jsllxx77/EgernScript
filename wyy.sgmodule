#!name=网易云 Cookie 提取
#!desc=MITM 解密 music.163.com，登录后自动从 Set-Cookie 提取完整 Cookie 并推送到服务器自动更新点歌接口。含三级诊断通知。
#!author=jsllxx77
#!homepage=https://github.com/jsllxx77/EgernScript
#!tag=网易云

[Script]
wyy_cookie = type=http-response,pattern=^https?:\/\/[^\/]*music\.163\.com\/,script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/refs/heads/main/wyy.js?v=3,script-update-interval=3600, requires-body=false, timeout=10, debug=true, tag=网易云Cookie提取, enable=true, argument=89ed22692976ce7faade5440a30a26c2

[MITM]
hostname = %APPEND% music.163.com, *.music.163.com
