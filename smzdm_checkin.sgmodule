#!name=什么值得买 每日签到
#!desc=SMZDM 抓 Cookie/SK + 定时签到。抓包只拦截非 /checkin 接口，避免 sign param not enough。
#!author=Shawn & Ali
#!homepage=https://github.com/jsllxx77/EgernScript
#!tag=Check-in

[Script]
# 抓取 user-api 下除 /checkin 以外的接口；需要 body 才能保存 sk，但不碰原生 /checkin
http-request ^https:\/\/user-api\.smzdm\.com\/(?!checkin(?:\/|$)).*$ script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/refs/heads/main/smzdm_checkin.js, requires-body=true, timeout=10, tag=什么值得买抓包, enable=true
cron "10 9 * * *" script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/refs/heads/main/smzdm_checkin.js, timeout=60, tag=什么值得买签到, enable=true

[MITM]
hostname = user-api.smzdm.com
