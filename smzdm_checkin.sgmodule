#!name=什么值得买 每日签到
#!desc=抓取 SMZDM APP Cookie/SK，并每日签到领取金币/积分。先开启 MITM 后打开什么值得买 APP 触发一次 user-api.smzdm.com 请求完成抓包。
#!author=Shawn & Ali
#!homepage=https://github.com/jsllxx77/EgernScript
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/smzdm.png
#!tag=Check-in

[Rewrite]
^https:\/\/user-api\.smzdm\.com\/(checkin|vip|task|dingyue|tuijian).* url script-request-header https://raw.githubusercontent.com/jsllxx77/EgernScript/refs/heads/main/smzdm_checkin.js

[Script]
http-request ^https:\/\/user-api\.smzdm\.com\/(checkin|vip|task|dingyue|tuijian).*$ script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/refs/heads/main/smzdm_checkin.js, requires-body=true, timeout=10, tag=什么值得买抓包, enable=true
cron "10 9 * * *" script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/refs/heads/main/smzdm_checkin.js, timeout=60, tag=什么值得买签到, enable=true

[MITM]
hostname = user-api.smzdm.com
