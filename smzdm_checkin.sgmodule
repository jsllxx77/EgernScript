#!name=什么值得买 每日签到
#!desc=SMZDM 抓 Cookie + 定时签到最终版。抓包只拦截非 /checkin 接口，避免 sign param not enough。
#!author=Shawn & Ali
#!homepage=https://github.com/jsllxx77/EgernScript
#!tag=Check-in

[Script]
# 仅抓取非签到接口，避免影响 APP 原生 /checkin POST 的 sign/body
http-request ^https:\/\/user-api\.smzdm\.com\/(vip|task|dingyue|tuijian).*$ script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/refs/heads/main/smzdm_checkin.js, requires-body=false, timeout=10, tag=什么值得买抓包, enable=true
cron "10 9 * * *" script-path=https://raw.githubusercontent.com/jsllxx77/EgernScript/refs/heads/main/smzdm_checkin.js, timeout=60, tag=什么值得买签到, enable=true

[MITM]
hostname = user-api.smzdm.com
